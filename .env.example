# Inicialização somente do Aldebaran. Não inclua aqui segredos dos microserviços.
# Copie para .env local ou preencha Environment no Dokploy. Nunca versione o .env real.
SERVER_PORT=8888

# HTTPS, sem token na URL. Ex.: https://github.com/universum-stellarum/SEU_REPOSITORIO_PRIVADO.git
CONFIG_GIT_URI=
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=
CONFIG_GIT_DEFAULT_LABEL=dev

# Chave simétrica forte e persistente; guarde backup seguro fora do Git.
ENCRYPT_KEY=
# HTTP Basic apenas para /encrypt, /decrypt e /key, inclusive suas variantes.
CONFIG_ADMIN_USERNAME=
CONFIG_ADMIN_PASSWORD=

# Valores com $, # ou espaços devem ser colocados entre aspas simples no formato .env.
# O Compose injeta explicitamente essas variáveis no container via environment.
